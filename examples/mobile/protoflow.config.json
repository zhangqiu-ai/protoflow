{
  "schemaVersion": 2,
  "prototypeDir": "prototype",
  "anchors": {
    "attribute": "data-pf",
    "requireScreenAnchor": true,
    "tokens": "prototype/tokens.json"
  },
  "targets": [
    {
      "id": "ios",
      "platform": "ios",
      "root": "ios",
      "driver": {
        "kind": "external",
        "command": {
          "argv": [
            "node",
            "../../scripts/ios-driver.js",
            "--bundle-id",
            "dev.protoflow.examples.tasks",
            "--device",
            "ProtoFlow iPhone 17",
            "--app",
            "ios/build/DerivedData/Build/Products/Debug-iphonesimulator/ProtoFlowTasks.app"
          ],
          "timeoutMs": 900000
        }
      },
      "build": {
        "argv": [
          "xcodebuild",
          "build",
          "-project",
          "ios/ProtoFlowTasks.xcodeproj",
          "-scheme",
          "ProtoFlowTasks",
          "-configuration",
          "Debug",
          "-destination",
          "generic/platform=iOS Simulator",
          "-derivedDataPath",
          "ios/build/DerivedData",
          "CODE_SIGNING_ALLOWED=NO",
          "-quiet"
        ],
        "timeoutMs": 1800000
      },
      "functional": {
        "argv": [
          "xcodebuild",
          "test",
          "-project",
          "ios/ProtoFlowTasks.xcodeproj",
          "-scheme",
          "ProtoFlowTasks",
          "-destination",
          "platform=iOS Simulator,name=ProtoFlow iPhone 17",
          "-derivedDataPath",
          "ios/build/DerivedData",
          "CODE_SIGNING_ALLOWED=NO",
          "-quiet"
        ],
        "timeoutMs": 1800000
      },
      "viewport": {
        "width": 402,
        "height": 778,
        "scale": 3
      }
    },
    {
      "id": "android",
      "platform": "android",
      "root": "android",
      "driver": {
        "kind": "external",
        "command": {
          "argv": [
            "node",
            "../../scripts/android-driver.js",
            "--package",
            "dev.protoflow.examples.tasks",
            "--avd",
            "ProtoFlow_Pixel",
            "--apk",
            "android/app/build/outputs/apk/debug/app-debug.apk"
          ],
          "timeoutMs": 900000
        }
      },
      "build": {
        "argv": [
          "android/gradlew",
          "-p",
          "android",
          "--no-daemon",
          "-q",
          "assembleDebug"
        ],
        "timeoutMs": 1800000
      },
      "functional": {
        "argv": [
          "android/gradlew",
          "-p",
          "android",
          "--no-daemon",
          "-q",
          "testDebugUnitTest"
        ],
        "timeoutMs": 1800000
      },
      "viewport": {
        "width": 360,
        "height": 730,
        "scale": 3
      },
      "deviations": [
        {
          "anchor": "settings.notify-toggle",
          "allow": [
            "layout"
          ]
        }
      ]
    },
    {
      "id": "react-native",
      "platform": "react-native",
      "root": "react-native",
      "functional": {
        "argv": [
          "npm",
          "--prefix",
          "react-native",
          "test",
          "--",
          "--ci"
        ],
        "timeoutMs": 600000
      },
      "variants": [
        {
          "id": "ios",
          "driver": {
            "kind": "external",
            "command": {
              "argv": [
                "node",
                "../../scripts/ios-driver.js",
                "--bundle-id",
                "dev.protoflow.examples.tasksrn",
                "--device",
                "ProtoFlow iPhone 17",
                "--app",
                "react-native/ios/build/DerivedData/Build/Products/Release-iphonesimulator/ProtoFlowTasksRN.app"
              ],
              "timeoutMs": 900000
            }
          },
          "build": {
            "argv": [
              "xcodebuild",
              "build",
              "-workspace",
              "react-native/ios/ProtoFlowTasksRN.xcworkspace",
              "-scheme",
              "ProtoFlowTasksRN",
              "-configuration",
              "Release",
              "-destination",
              "generic/platform=iOS Simulator",
              "-derivedDataPath",
              "react-native/ios/build/DerivedData",
              "CODE_SIGNING_ALLOWED=NO",
              "-quiet"
            ],
            "timeoutMs": 3600000
          },
          "viewport": {
            "width": 402,
            "height": 778,
            "scale": 3
          }
        },
        {
          "id": "android",
          "driver": {
            "kind": "external",
            "command": {
              "argv": [
                "node",
                "../../scripts/android-driver.js",
                "--package",
                "dev.protoflow.examples.tasksrn",
                "--avd",
                "ProtoFlow_Pixel",
                "--apk",
                "react-native/android/app/build/outputs/apk/release/app-release.apk"
              ],
              "timeoutMs": 900000
            }
          },
          "build": {
            "argv": [
              "react-native/android/gradlew",
              "-p",
              "react-native/android",
              "--no-daemon",
              "-q",
              "assembleRelease"
            ],
            "timeoutMs": 3600000
          },
          "viewport": {
            "width": 360,
            "height": 730,
            "scale": 3
          },
          "deviations": [
            {
              "anchor": "settings.notify-toggle",
              "allow": [
                "layout"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "flutter",
      "platform": "flutter",
      "root": "flutter",
      "functional": {
        "argv": [
          "flutter/tool/flutterw",
          "test"
        ],
        "timeoutMs": 1800000
      },
      "deviations": [
        {
          "anchor": "settings.notify-toggle",
          "allow": [
            "layout"
          ]
        }
      ],
      "variants": [
        {
          "id": "ios",
          "driver": {
            "kind": "external",
            "command": {
              "argv": [
                "node",
                "../../scripts/ios-driver.js",
                "--bundle-id",
                "dev.protoflow.examples.protoflowTasks",
                "--device",
                "ProtoFlow iPhone 17",
                "--app",
                "flutter/build/ios/iphonesimulator/Runner.app"
              ],
              "timeoutMs": 900000
            }
          },
          "build": {
            "argv": [
              "flutter/tool/flutterw",
              "build",
              "ios",
              "--simulator",
              "--debug"
            ],
            "timeoutMs": 3600000
          },
          "viewport": {
            "width": 402,
            "height": 778,
            "scale": 3
          }
        },
        {
          "id": "android",
          "driver": {
            "kind": "external",
            "command": {
              "argv": [
                "node",
                "../../scripts/android-driver.js",
                "--package",
                "dev.protoflow.examples.protoflow_tasks",
                "--avd",
                "ProtoFlow_Pixel",
                "--apk",
                "flutter/build/app/outputs/flutter-apk/app-release.apk"
              ],
              "timeoutMs": 900000
            }
          },
          "build": {
            "argv": [
              "flutter/tool/flutterw",
              "build",
              "apk",
              "--release",
              "--no-tree-shake-icons"
            ],
            "timeoutMs": 3600000
          },
          "viewport": {
            "width": 360,
            "height": 730,
            "scale": 3
          }
        }
      ]
    }
  ],
  "policy": {
    "maxRepairAttempts": 2,
    "requireHumanReview": true,
    "sequentialVersions": true
  },
  "adapters": {
    "codex": {
      "command": null
    }
  },
  "release": {
    "requireTargets": [
      "ios",
      "android",
      "react-native",
      "flutter"
    ]
  }
}
