<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The capture test launches the app under test by package name. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application android:label="ProtoFlow driver">
        <activity android:name=".ProbeActivity" android:exported="false" android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
    </application>
</manifest>
