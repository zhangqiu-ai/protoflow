{
  "schemaVersion": 1,
  "prototypeDir": "prototype",
  "mappings": [{
    "id": "home",
    "prototypeFiles": ["prototype/index.html"],
    "prototype": "main",
    "application": "main",
    "component": "src/Home.tsx",
    "priority": "normal"
  }],
  "classification": { "rules": [] },
  "policy": { "maxRepairAttempts": 3, "requireHumanReview": true },
