  "visual": { "scenes": [], "maxDiffRatio": 0.01, "geometryTolerance": 1, "pixelThreshold": 0.1 },
  "adapters": { "codex": { "command": null }, "specKit": { "command": null }, "bmad": { "command": null } }
}
