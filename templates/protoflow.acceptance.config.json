{
  "schemaVersion": 1,
  "prototypeDir": "prototype",
  "mappings": [
    {
      "id": "page-region",
      "prototypeFiles": [
        "prototype/<page>.html",
        "prototype/<shared-resource>"
      ],
      "prototype": "<prototype-css-selector>",
      "application": "<application-css-selector>",
      "component": "<path/to/your/component>",
      "priority": "normal"
    }
  ],
  "classification": {
    "rules": []
  },
  "policy": {
    "maxRepairAttempts": 3,
    "requireHumanReview": true,
    "sequentialVersions": true
  },
  "watch": {
    "pollMs": 200,
    "idleMs": 1000
  },
  "verification": {
    "build": null,
    "functional": {
      "adapter": "acceptance"
    }
  },
  "visual": {
    "scenes": [],
    "maxDiffRatio": 0.01,
    "geometryTolerance": 1,
    "pixelThreshold": 0.1,
    "mode": "adapter"
  },
  "adapters": {
    "codex": {
      "command": null
    },
    "specKit": {
      "command": null,
      "install": {
        "argv": [
          "uvx",
          "--from",
          "specify-cli",
          "specify",
          "init",
          "--here",
          "--force",
          "--non-interactive",
          "--integration",
          "codex",
          "--script",
          "sh"
        ],
        "timeoutMs": 600000
      }
    },
    "bmad": {
      "command": null,
      "install": {
        "argv": [
          "npx",
          "--yes",
          "skills",
          "add",
          "bmad-code-org/BMAD-METHOD",
          "--skill",
          "*",
          "--agent",
          "codex",
          "--yes"
        ],
        "timeoutMs": 600000
      }
    },
    "acceptance": {
      "command": {
        "argv": [
          "node",
          "scripts/acceptance.mjs"
        ],
        "timeoutMs": 180000
      },
      "options": {}
    }
  }
}
